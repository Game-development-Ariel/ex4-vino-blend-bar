# Formatting rules for this repository.
# Editors (VS Code with the C# extension, Rider, Visual Studio) read this file and format code the same way
# the course checker (dotnet-format) expects, so the linter stays green.
root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Braces on their own line (Allman style), like the rest of the code.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Indentation inside switch statements and blocks.
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false

# Spaces.
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_cast = false
csharp_space_around_binary_operators = before_and_after
csharp_space_after_comma = true

[*.{md,yml,yaml,json,asmdef}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
